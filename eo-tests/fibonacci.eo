# This is a simple object for testing of REO engine, used by eo_test.rs:
# it calculates "f 6" with the help of the recursive "f" object,
# where "f 0" and "f 1" are both 1, and expects it to be equal to 13.

+spdx SPDX-FileCopyrightText: Copyright (c) 2022-2026 Yegor Bugayenko
+spdx SPDX-License-Identifier: MIT

[] > fibonacci
  13 > expected
  f 6 > @

  [x] > f
    if. > @
      x.lt 2
      1
      plus.
        Q.fibonacci.f
          x.minus 1
        Q.fibonacci.f
          x.minus 2
